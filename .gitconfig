[user]
	name = Jerome Dalbert
	email = jerome.dalbert@gmail.com

[core]
  ignorecase = false
  excludesfile = /Users/jerome/.gitignore_global
  attributesfile = /Users/jerome/.gitattributes

[absorb]
  autoStageIfNothingStaged = true
  maxStack=50
  oneFixupPerCommit = true

[alias]
  ignore = !git update-index --assume-unchanged
  unignore = !git update-index --no-assume-unchanged
  ignored = !git ls-files -v | grep ^[a-z]

[color]
  ui = always

[color "branch"]
  worktree = normal

[commit]
  gpgsign = true

[diff]
  noprefix = true
  algorithm = histogram
  renames = true

[diff-so-fancy]
  markEmptyLines = false

[filter "lfs"]
  process = git-lfs filter-process
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f

[include]
  path = ~/.gitconfig_local

[init]
  defaultBranch = main

# [merge "bundlelock"]
#   name = bundle lock
#   driver = bundle lock

[merge "railsschema"]
  name = newer Rails schema version
  driver = "ruby -e '\
    system %(git), %(merge-file), %(--marker-size=%L), %(%A), %(%O), %(%B);\
    b = File.read(%(%A));\
    b.sub!(/^<+ .*\\nActiveRecord::Schema\\.define.version: ([0-9_]+). do\\n=+\\nActiveRecord::Schema\\.define.version: ([0-9_]+). do\\n>+ .*/) do;\
      %(ActiveRecord::Schema.define(version: #{[$1, $2].max}) do);\
    end;\
    File.open(%(%A), %(w)) {|f| f.write(b)};\
    exit 1 if b.include?(%(<)*%L)'"

[merge "data-migrate-schema"]
  name = newer data_migrate schema version
  driver = "ruby -e '\
    system %(git), %(merge-file), %(--marker-size=%L), %(%A), %(%O), %(%B);\
    b = File.read(%(%A));\
    b.sub!(/^<+ .*\\nDataMigrate::Data\\.define.version: ([0-9_]+).\\n=+\\nDataMigrate::Data\\.define.version: ([0-9_]+).\\n>+ .*/) do;\
      %(DataMigrate::Data.define(version: #{[$1, $2].max}));\
    end;\
    File.open(%(%A), %(w)) {|f| f.write(b)};\
    exit 1 if b.include?(%(<)*%L)'"

[push]
  default = simple
	autoSetupRemote = true

[rebase]
  updateRefs = true

[rerere]
	enabled = true
	autoupdate = true
